# Lokale Werte für Docker Compose. Diese Beispieldatei niemals direkt als .env verwenden.
COMPOSE_PROJECT_NAME=projekt-x
MARIADB_PORT=3306
MARIADB_DATABASE=projekt_x_dev
MARIADB_USER=projectx_app
MARIADB_PASSWORD=hier-ein-langes-zufaelliges-passwort-eintragen
MARIADB_ROOT_PASSWORD=hier-ein-anderes-langes-zufaelliges-passwort-eintragen
REDIS_PORT=6379
REDIS_PASSWORD=hier-ein-drittes-langes-zufaelliges-passwort-eintragen
API_HOST=127.0.0.1
API_PORT=3001
MARIADB_HOST=127.0.0.1
REDIS_HOST=127.0.0.1
